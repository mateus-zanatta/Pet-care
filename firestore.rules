rules_version = '2';

// Regras do Firestore — Fase 1.
// Princípio: cada pessoa só acessa os próprios dados; quem recebeu um pet em
// compartilhamento só acessa AQUELE pet. Tudo o que não está aqui é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Conta "de verdade" (e-mail, Google, Apple). Anônimos não criam pets.
    function isRegisteredUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function memberPath(petId, uid) {
      return /databases/$(database)/documents/pet_members/$(petId + '_' + uid);
    }

    function isMember(petId) {
      return signedIn() && exists(memberPath(petId, request.auth.uid));
    }

    function memberRole(petId) {
      return get(memberPath(petId, request.auth.uid)).data.role;
    }

    function canEditPet(petId) {
      return isMember(petId) && memberRole(petId) in ['owner', 'caregiver'];
    }

    function isString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'locale', 'isAnonymous', 'consents', 'createdAt', 'updatedAt'])
        && request.resource.data.locale in ['pt-BR', 'en']
        && request.resource.data.isAnonymous is bool;

      allow update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'locale', 'isAnonymous', 'consents', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.locale in ['pt-BR', 'en'];

      // A exclusão acontece pela Cloud Function deleteAccount.
      allow delete: if false;
    }

    // ---------- entitlements/{uid}: premium (escrito só pelo servidor) ----------
    match /entitlements/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // ---------- pets/{petId} ----------
    match /pets/{petId} {
      allow read: if isMember(petId);

      // Criação: o dono cria o pet e, NO MESMO lote, o próprio pet_members de dono.
      allow create: if isRegisteredUser()
        && request.resource.data.ownerId == request.auth.uid
        && existsAfter(memberPath(petId, request.auth.uid))
        && getAfter(memberPath(petId, request.auth.uid)).data.role == 'owner'
        && validPet(request.resource.data);

      allow update: if canEditPet(petId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.createdAt == resource.data.createdAt
        && validPet(request.resource.data);

      // Exclusão: apenas pela Cloud Function deletePet (apaga subcoleções e arquivos).
      allow delete: if false;

      // ---------- pets/{petId}/medications/{medId} ----------
      // O app só REGISTRA o que o veterinário prescreveu (nunca sugere medicamento ou dose).
      match /medications/{medId} {
        allow read: if isMember(petId);

        allow create: if canEditPet(petId)
          && request.resource.data.createdBy == request.auth.uid
          && validMedication(request.resource.data);

        allow update: if canEditPet(petId)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && validMedication(request.resource.data);

        allow delete: if canEditPet(petId);
      }

      // ---------- pets/{petId}/dose_logs/{logId} (logId = {medicationId}_{minutos}) ----------
      match /dose_logs/{logId} {
        allow read: if isMember(petId);

        allow create: if canEditPet(petId)
          && request.resource.data.byUid == request.auth.uid
          && validDoseLog(petId, logId, request.resource.data);

        // Corrigir "dei" <-> "pulei": quem corrige passa a constar como autor.
        allow update: if canEditPet(petId)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.medicationId == resource.data.medicationId
          && request.resource.data.scheduledFor == resource.data.scheduledFor
          // createdAt: o mesmo de antes OU o carimbo do servidor (registrar de novo a mesma dose é idempotente).
          && (request.resource.data.createdAt == resource.data.createdAt
              || request.resource.data.createdAt == request.time)
          && validDoseLog(petId, logId, request.resource.data);

        // Desfazer um registro feito por engano.
        allow delete: if canEditPet(petId);
      }
    }

    function validPet(d) {
      return d.keys().hasOnly([
               'ownerId', 'origin', 'name', 'species', 'breed', 'sex', 'neutered',
               'birthDate', 'approxAge', 'weightKg', 'microchip', 'rga', 'cor',
               'naturalidade', 'allergies', 'notes', 'address', 'photoPath',
               'photoUpdatedAt', 'sinpatinhas', 'tutor', 'rescueId', 'rescueStatus',
               'createdAt', 'updatedAt'])
        && d.keys().hasAll(['ownerId', 'origin', 'name', 'species', 'sex', 'neutered', 'createdAt', 'updatedAt'])
        && d.origin in ['manual', 'rescue', 'rga_import']
        && isString(d.name, 60) && d.name.size() >= 1
        && d.species in ['dog', 'cat', 'bird', 'rabbit', 'rodent', 'reptile', 'other']
        && d.sex in ['male', 'female', 'unknown']
        && d.neutered in ['yes', 'no', 'unknown']
        && (!('breed' in d) || isString(d.breed, 60))
        && (!('rga' in d) || isString(d.rga, 20))
        && (!('cor' in d) || isString(d.cor, 40))
        && (!('allergies' in d) || isString(d.allergies, 500))
        && (!('notes' in d) || isString(d.notes, 1000))
        && (!('weightKg' in d) || (d.weightKg is number && d.weightKg > 0 && d.weightKg <= 200));
    }

    function isIsoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isTime(v) {
      return v is string && v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isUtcInstant(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$');
    }

    function validFrequency(f) {
      return f is map
        && (
          (f.kind == 'interval'
            && f.keys().hasOnly(['kind', 'everyHours'])
            && f.keys().hasAll(['kind', 'everyHours'])
            && f.everyHours is int && f.everyHours >= 1 && f.everyHours <= 168)
          ||
          (f.kind == 'fixed'
            && f.keys().hasOnly(['kind', 'times'])
            && f.keys().hasAll(['kind', 'times'])
            && f.times is list && f.times.size() >= 1 && f.times.size() <= 12
            // As regras não têm laços: conferem o tamanho, o 1º e o último horário (o Zod do app confere todos).
            && isTime(f.times[0]) && isTime(f.times[f.times.size() - 1]))
        );
    }

    function validMedication(d) {
      return d.keys().hasOnly([
               'name', 'barcode', 'batch', 'expiresOn', 'dose', 'frequency', 'startDate', 'startTime',
               'endDate', 'prescribedOn', 'vet', 'place', 'status', 'notes',
               'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'dose', 'frequency', 'startDate', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && isString(d.name, 80) && d.name.size() >= 1
        && d.status in ['active', 'completed', 'suspended']
        && d.dose is map
        && d.dose.keys().hasOnly(['amount', 'unit', 'route'])
        && d.dose.keys().hasAll(['amount', 'unit', 'route'])
        && isString(d.dose.amount, 20) && d.dose.amount.size() >= 1
        && isString(d.dose.unit, 20) && d.dose.unit.size() >= 1
        && d.dose.route in ['oral', 'topical', 'injectable', 'ophthalmic', 'otic', 'other']
        && validFrequency(d.frequency)
        && isIsoDate(d.startDate)
        && (!('startTime' in d) || isTime(d.startTime))
        && (!('endDate' in d) || isIsoDate(d.endDate))
        && (!('expiresOn' in d) || isIsoDate(d.expiresOn))
        && (!('prescribedOn' in d) || isIsoDate(d.prescribedOn))
        && (!('barcode' in d) || isString(d.barcode, 64))
        && (!('batch' in d) || isString(d.batch, 40))
        && (!('notes' in d) || isString(d.notes, 1000))
        && (!('vet' in d) || (d.vet is map && d.vet.keys().hasOnly(['name', 'crmvNumber', 'crmvUf'])))
        && (!('place' in d) || (d.place is map
             && d.place.keys().hasOnly(['kind', 'text'])
             && d.place.kind in ['home', 'clinic', 'address']));
    }

    function validDoseLog(petId, logId, d) {
      return d.keys().hasOnly(['medicationId', 'scheduledFor', 'outcome', 'actualAt', 'byUid', 'byName', 'createdAt'])
        && d.keys().hasAll(['medicationId', 'scheduledFor', 'outcome', 'actualAt', 'byUid', 'createdAt'])
        && d.medicationId is string
        && logId.matches('^.+_[0-9]{1,12}$')
        && logId.split('_')[0] == d.medicationId
        && exists(/databases/$(database)/documents/pets/$(petId)/medications/$(d.medicationId))
        && d.outcome in ['given', 'skipped']
        && isUtcInstant(d.scheduledFor)
        && isUtcInstant(d.actualAt)
        && d.createdAt is timestamp
        && (!('byName' in d) || isString(d.byName, 80));
    }

    // ---------- pet_members/{petId}_{uid} ----------
    match /pet_members/{memberId} {
      // Cada pessoa vê as próprias participações; o dono vê quem participa do seu pet.
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
            || (isMember(resource.data.petId) && memberRole(resource.data.petId) == 'owner'));

      // Só o dono se cria como 'owner' (junto do pet). Convites passam pela Cloud Function.
      allow create: if isRegisteredUser()
        && memberId == request.resource.data.petId + '_' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'owner'
        && request.resource.data.keys().hasOnly(['petId', 'uid', 'role', 'displayName', 'addedAt'])
        && existsAfter(/databases/$(database)/documents/pets/$(request.resource.data.petId))
        && getAfter(/databases/$(database)/documents/pets/$(request.resource.data.petId)).data.ownerId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
