{
  "name": "@petcare/functions",
  "version": "0.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore,storage",
    "test:emu": "vitest run --config vitest.emu.config.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@petcare/shared": "*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
