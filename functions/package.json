    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@petcare/shared": "*",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
