# Copie para .env.local (não vai para o git). Variáveis EXPO_PUBLIC_* ficam visíveis no app:
# nunca coloque segredos aqui.

# Login com Google: "ID do cliente da Web" (Console Firebase > Authentication > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Monitoramento (opcionais; sem valor, ficam desligados)
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Desenvolvimento SEM Firebase na nuvem (build "development-emulators"): NADA a configurar aqui.
# O app detecta o projeto falso e usa os emuladores do seu computador automaticamente, no mesmo
# endereço do Metro. Veja docs/SETUP.md, "Caminho A". As variáveis abaixo são opcionais:
#
# Só para ligar os emuladores com um projeto Firebase REAL (caminho B):
EXPO_PUBLIC_USE_EMULATORS=false
# Só se a descoberta automática do endereço do computador falhar (no Windows: `ipconfig`):
# EXPO_PUBLIC_EMULATOR_HOST=192.168.0.10

# --- Lidas pelo app.config.ts (EAS: use "file secrets" para os arquivos do Firebase) ---
# APP_IDENTIFIER=br.com.seunome.petcare
# GOOGLE_SERVICES_JSON=./firebase/google-services.json
# GOOGLE_SERVICES_PLIST=./firebase/GoogleService-Info.plist
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.XXXX   (opcional se o plist existir)
