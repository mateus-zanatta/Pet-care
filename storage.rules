rules_version = '2';

// Regras do Storage — Fase 1.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function petMemberDoc(petId) {
      return /databases/(default)/documents/pet_members/$(petId + '_' + request.auth.uid);
    }

    function isPetMember(petId) {
      return signedIn() && firestore.exists(petMemberDoc(petId));
    }

    function canEditPet(petId) {
      return isPetMember(petId)
        && firestore.get(petMemberDoc(petId)).data.role in ['owner', 'caregiver'];
    }

    function isImageUnder(maxBytes) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < maxBytes;
    }

    function isImageOrPdfUnder(maxBytes) {
      return (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && request.resource.size < maxBytes;
    }

    // Anexos de saúde (foto da receita, exames em PDF...): imagem ou PDF de até 10 MB.
    match /pets/{petId}/attachments/{allPaths=**} {
      allow read: if isPetMember(petId);
      allow write: if canEditPet(petId) && isImageOrPdfUnder(10 * 1024 * 1024);
      allow delete: if canEditPet(petId);
    }

    // Foto de perfil e demais arquivos do pet: membros leem; dono/cuidador gravam (só imagens).
    match /pets/{petId}/{allPaths=**} {
      allow read: if isPetMember(petId);
      allow write: if canEditPet(petId) && isImageUnder(10 * 1024 * 1024);
      allow delete: if canEditPet(petId);
    }

    // ---------- Fotos das centrais (até 5 por registro, só .jpg de até 8 MB) ----------
    function isRegisteredUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function centralDoc(collection, id) {
      return /databases/(default)/documents/$(collection)/$(id);
    }

    function ownsCentral(collection, id, field) {
      return isRegisteredUser()
        && firestore.exists(centralDoc(collection, id))
        && firestore.get(centralDoc(collection, id)).data[field] == request.auth.uid;
    }

    function isCentralPhoto(fileName) {
      return fileName.matches('[A-Za-z0-9_-]+[.]jpg')
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 8 * 1024 * 1024;
    }

    // Adoção: todos que veem o anúncio veem as fotos; só quem anunciou envia/apaga.
    match /adoptions/{listingId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if ownsCentral('adoption_listings', listingId, 'ownerId') && isCentralPhoto(fileName);
      allow delete: if ownsCentral('adoption_listings', listingId, 'ownerId');
    }

    // Resgate: só quem tem conta vê (mesma regra do alerta).
    match /rescues/{alertId}/{fileName} {
      allow read: if isRegisteredUser();
      allow create, update: if ownsCentral('rescue_alerts', alertId, 'reporterId') && isCentralPhoto(fileName);
      allow delete: if ownsCentral('rescue_alerts', alertId, 'reporterId');
    }

    // Denúncia: provas são privadas (só quem denunciou).
    match /reports/{reportId}/{fileName} {
      allow read: if ownsCentral('reports', reportId, 'reporterId');
      allow create, update: if ownsCentral('reports', reportId, 'reporterId') && isCentralPhoto(fileName);
      allow delete: if ownsCentral('reports', reportId, 'reporterId');
    }

    // Dados privados de uma pessoa: só ela acessa.
    match /users/{uid}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
